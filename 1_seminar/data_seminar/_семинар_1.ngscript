            "scrollTop": 0
          },
          "maskInfo": {
            "isMaskVisible": true,
            "isEditorVisible": true,
            "isAutoplayActive": false
          }
        }
      }
    },
    {
      "id": "aa71a0c1",
      "cell_type": "markdown",
      "source": [
        "Сохраним эти данные в новый MAT-файл."
      ],
      "attachments": {},
      "metadata": {
        "name": "Название секции",
        "engee": {
          "isDisplay": true,
          "isParagraph": false,
          "isClosedParagraph": false,
          "amountHideCellsInside": 0,
          "codeOutputView": "col",
          "codeOutputHidden": false
        }
      }
    },
    {
      "id": "e66d06ec",
      "cell_type": "code",
      "source": [
        "matwrite(\"Подшипник_тест.mat\", данные)"
